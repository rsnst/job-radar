{
  "manifest_version": 3,
  "name": "Job Compass Workday Helper",
  "version": "1.0.0",
  "description": "Locally fills clearly matched Workday application fields from a profile you import.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://*.myworkdayjobs.com/*", "https://*.myworkday.com/*"],
  "action": { "default_title": "Job Compass Workday Helper", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://*.myworkdayjobs.com/*", "https://*.myworkday.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
